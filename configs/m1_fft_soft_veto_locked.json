{
  "schema": "pv-2m-dinov3sat-m1-fft-soft-veto-locked-v1",
  "module": "Module_1_SupportAdaptiveFFTSoftVeto",
  "base_architecture": "R (M3_Pruned_Ref 3-module decomposition, replacing mid-layer Softplus veto only)",
  "locked_before_dev_experiment": true,
  "no_fixed_band_fallback": true,
  "fft_window": {
